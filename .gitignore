.dart_tool/
.packages
build/
dist/
.flutter-plugins
.flutter-plugins-dependencies
*.iml
.idea/
android/local.properties
android/.gradle/
android/.kotlin/
# Real Android release signing key - never commit this (see build.gradle.kts).
android/key.properties
*.keystore
*.jks
ios/Pods/

# Real financial database - never commit this, wherever it happens to sit
# relative to the repo (CLAUDE.md says one level up, but a plain zip
# extraction can leave it inside instead).
Database/
*.mmb

# Server deployment packages - compiled binaries built on demand (see
# server/deploy_linux_x64/LISEZMOI_DEPLOIEMENT.md), same as build/ above.
# start.sh/LISEZMOI_DEPLOIEMENT.md in the same folder ARE tracked (real
# authored source, not build output).
server/deploy_*/*server_linux_x64*
server/deploy_*/libsqlite3.so
# Artefacts d'exécution locale de start.sh (log + fichier PID) - jamais
# committés non plus.
server/deploy_*/server.log
server/deploy_*/server.pid
