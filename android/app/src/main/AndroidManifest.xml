<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Found 2026-08-04 missing entirely from this (release) manifest -
         debug/profile builds get it for free from Flutter's own tooling
         boilerplate, which masked that it was never actually declared here.
         Without it, every network call from a real release APK fails
         outright (not a runtime-grantable permission - it gates whether the
         OS allows sockets at all), which silently broke the Android update
         checker (update_prompt_io.dart, shipped earlier the same day) and
         would have equally broken WebDAV sync before it ever got the chance
         to run. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lets this app trigger the system installer for a downloaded APK
         (see AndroidApkInstaller/update_prompt_io.dart) - required on
         Android 8+ regardless of the FileProvider below; without it the OS
         blocks installation from this app with a "for your security"
         prompt instead of asking the user to grant "install unknown apps"
         access. Harmless to declare even though this app is never
         distributed through the Play Store (sideloaded from GitHub
         releases only), which is the only context where this permission
         draws extra review scrutiny. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Android 13+ (API 33) requires this declared *and* granted at runtime
         before any notification can show - see SyncNotificationService,
         which requests it lazily on the first background auto-sync rather
         than up front at first launch. Silently ignored (auto-granted) on
         older Android versions. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Microphone access for voice-entry transactions (speech_to_text,
         Android only - see lib/widgets/voice_transaction_sheet.dart).
         speech_to_text also requests this at runtime before first use; it
         must still be declared here or that runtime request itself fails. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="money_manager"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Hands the downloaded update APK (see AndroidApkInstaller, which
             writes it to the app's cache dir via path_provider's
             getTemporaryDirectory()) to the system package installer as a
             content:// URI - a plain file:// URI is blocked on API 24+
             (StrictMode FileUriExposedException) for anything shared
             outside this app's own process. android:exported="false" -
             nothing outside this app can reach it directly; the installer
             app it's handed to gets a one-off grant instead (see
             FLAG_GRANT_READ_URI_PERMISSION in MainActivity.kt). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
